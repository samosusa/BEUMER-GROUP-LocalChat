#
# LocalChat UI — live container.
#
# Builds the renderer with LOCALCHAT_SERVICE=live (no mocks) and serves it behind nginx,
# which reverse-proxies the service's routes to the "app" container so the browser's calls
# stay same-origin — src/app.py installs no CORS middleware, so a direct cross-origin call
# from this container to the app container would otherwise be refused by the browser. See
# docs/backend-wiring.md and docker/nginx.live.conf.
#
# This is a review/local target, not the shipping artefact: the product ships as the
# Electron installer built by `npm run package`. Requires the "app" service (docker compose
# up --build app) and a GGUF under data/models/ to actually answer questions.
#
# Build:  docker compose build ui-live
# Run:    docker compose up app ui-live

# ---------------------------------------------------------------------------
# Stage 1 — install dependencies
# ---------------------------------------------------------------------------
FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/tokens/package.json ./packages/tokens/
COPY apps/renderer/package.json ./apps/renderer/
COPY apps/desktop/package.json ./apps/desktop/

# The Electron binary is a ~100 MB download that this image never runs.
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
RUN npm ci --no-audit --no-fund

# ---------------------------------------------------------------------------
# Stage 2 — build the renderer
# ---------------------------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/renderer/node_modules ./apps/renderer/node_modules
COPY . .

# Fail the image rather than shipping a bundle that does not typecheck.
RUN npm run build --workspace @localchat/contracts \
 && npx tsc --noEmit -p apps/renderer/tsconfig.json

# No LOCALCHAT_MOCKS here: __USE_MOCKS__ is only true in production when that flag is set,
# so this build ships with the mock service worker compiled out. LOCALCHAT_SERVICE=live
# points chats, documents, ingestion and models at the proxied service routes below.
ENV LOCALCHAT_SERVICE=live
RUN npm run build --workspace @localchat/renderer

# ---------------------------------------------------------------------------
# Stage 3 — serve
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

LABEL org.opencontainers.image.title="BEUMER LocalChat UI (live)" \
      org.opencontainers.image.description="Live build of the LocalChat interface, proxied to the FastAPI RAG service." \
      org.opencontainers.image.source="https://github.com/samosusa/BEUMER-GROUP-LocalChat"

COPY docker/nginx.live.conf /etc/nginx/conf.d/default.conf
COPY docker/proxy_params.conf /etc/nginx/proxy_params.conf
COPY --from=build /app/apps/renderer/dist /usr/share/nginx/html

# Runs unprivileged: nginx:alpine ships an nginx user, and there is nothing here worth root.
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx \
 && touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid
USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
