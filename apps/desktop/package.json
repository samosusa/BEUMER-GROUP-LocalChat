{
  "name": "@localchat/desktop",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Electron shell for LocalChat: window lifecycle, tray, global hotkey, quick-ask window and the hardened bridge to the local service.",
  "main": "./out/main/index.cjs",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"electron .\"",
    "start": "electron .",
    "package": "electron-builder --publish never",
    "clean": "rm -rf out release",
    "package:win": "electron-builder --win --publish never",
    "package:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "@localchat/contracts": "*",
    "electron-store": "^11.0.2",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.0",
    "tsup": "^8.5.0"
  }
}
